pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Starting Build...'
                echo 'Checking project files...'
                sh 'ls -la'
            }
        }

        stage('Test') {
            steps {
                echo 'Starting Tests...'
                sh 'test -f index.html'
                echo 'Test completed successfully.'
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
        }

        failure {
            echo 'CI/CD Pipeline failed. Check Console Output.'
        }
    }
}
